# Gather basic hardware information for a Windows PC.
# Run in PowerShell; administrator rights are not normally required.
# This script only reads local system information and does not upload or transmit it.

$ErrorActionPreference = 'Stop'

function Format-Bytes {
    param([Nullable[UInt64]] $Bytes)

    if ($null -eq $Bytes) { return 'Unknown' }
    $value = [double]$Bytes
    foreach ($unit in @('B', 'KB', 'MB', 'GB', 'TB', 'PB')) {
        if ($value -lt 1024 -or $unit -eq 'PB') {
            if ($unit -eq 'B') { return ('{0:N0} {1}' -f $value, $unit) }
            return ('{0:N2} {1}' -f $value, $unit)
        }
        $value /= 1024
    }
}

function Get-MemoryTypeName {
    param([int] $Code)

    $types = @{
        0 = 'Unknown'; 1 = 'Other'; 2 = 'DRAM'; 3 = 'Synchronous DRAM';
        4 = 'Cache DRAM'; 5 = 'EDO'; 6 = 'EDRAM'; 7 = 'VRAM'; 8 = 'SRAM';
        9 = 'RAM'; 10 = 'ROM'; 11 = 'Flash'; 12 = 'EEPROM'; 13 = 'FEPROM';
        14 = 'EPROM'; 15 = 'CDRAM'; 16 = '3DRAM'; 17 = 'SDRAM'; 18 = 'SGRAM';
        19 = 'RDRAM'; 20 = 'DDR'; 21 = 'DDR2'; 22 = 'DDR2 FB-DIMM';
        24 = 'DDR3'; 25 = 'FBD2'; 26 = 'DDR4'; 27 = 'LPDDR';
        28 = 'LPDDR2'; 29 = 'LPDDR3'; 30 = 'LPDDR4'; 33 = 'Logical NVDIMM';
        34 = 'HBM'; 35 = 'HBM2'; 36 = 'DDR5'; 37 = 'LPDDR5'
    }

    if ($types.ContainsKey($Code) -and $Code -ne 0) { return $types[$Code] }
    return 'Unknown'
}

function Get-FirstUsableValue {
    param([object[]] $Values)

    foreach ($value in $Values) {
        if ($null -ne $value -and -not [string]::IsNullOrWhiteSpace([string]$value)) {
            return ([string]$value).Trim()
        }
    }
    return 'Unknown'
}

function Write-Section {
    param([Parameter(Mandatory)][string] $Title)

    Write-Host "" 
    Write-Host ('=' * 70) -ForegroundColor DarkCyan
    Write-Host ("  $Title") -ForegroundColor Cyan
    Write-Host ('=' * 70) -ForegroundColor DarkCyan
}

function Write-Field {
    param(
        [Parameter(Mandatory)][string] $Label,
        [AllowNull()][AllowEmptyString()][object] $Value
    )

    $displayValue = if ($null -eq $Value -or [string]::IsNullOrWhiteSpace([string]$Value)) {
        'Unknown'
    } else {
        [string]$Value
    }

    Write-Host ('{0,-24}' -f ($Label + ':')) -ForegroundColor DarkGray -NoNewline
    Write-Host $displayValue
}

function Write-Subsection {
    param([Parameter(Mandatory)][string] $Title)

    Write-Host ""
    Write-Host $Title -ForegroundColor Yellow
    Write-Host ('-' * $Title.Length) -ForegroundColor DarkGray
}

try {
    $computerSystem = Get-CimInstance -ClassName Win32_ComputerSystem
    $operatingSystem = Get-CimInstance -ClassName Win32_OperatingSystem
    $processors = @(Get-CimInstance -ClassName Win32_Processor)
    $memoryModules = @(Get-CimInstance -ClassName Win32_PhysicalMemory)
    $memoryArrays = @(Get-CimInstance -ClassName Win32_PhysicalMemoryArray)
    $baseBoards = @(Get-CimInstance -ClassName Win32_BaseBoard)
    $bios = Get-CimInstance -ClassName Win32_BIOS
    $physicalDisks = @(Get-CimInstance -ClassName Win32_DiskDrive)
    $logicalDisks = @(Get-CimInstance -ClassName Win32_LogicalDisk -Filter 'DriveType=3')

    Write-Section 'COMPUTER INFORMATION'
    Write-Field 'Computer name' $computerSystem.Name
    Write-Field 'Operating system' $operatingSystem.Caption

    Write-Section 'CPU'
    if ($processors.Count -eq 0) {
        Write-Host '  No processor information was reported.' -ForegroundColor DarkYellow
    } else {
        $cpuNumber = 1
        foreach ($cpu in $processors) {
            if ($processors.Count -gt 1) { Write-Subsection ('Processor ' + $cpuNumber) }
            $speed = if ($cpu.MaxClockSpeed) { '{0:N0} MHz' -f $cpu.MaxClockSpeed } else { 'Unknown' }
            Write-Field 'Make' (Get-FirstUsableValue @($cpu.Manufacturer))
            Write-Field 'Model' (Get-FirstUsableValue @($cpu.Name))
            Write-Field 'Maximum speed' $speed
            $cpuNumber++
        }
    }

    $installedMemoryBytes = [UInt64]0
    foreach ($module in $memoryModules) {
        if ($module.Capacity) { $installedMemoryBytes += [UInt64]$module.Capacity }
    }
    $maximumMemoryBytes = [UInt64]0
    foreach ($array in $memoryArrays) {
        if ($array.MaxCapacityEx) {
            $maximumMemoryBytes += [UInt64]$array.MaxCapacityEx
        } elseif ($array.MaxCapacity) {
            $maximumMemoryBytes += ([UInt64]$array.MaxCapacity * 1KB)
        }
    }

    Write-Section 'MEMORY'
    Write-Field 'Installed memory' (Format-Bytes $installedMemoryBytes)
    Write-Field 'Maximum supported' (Format-Bytes $maximumMemoryBytes)
    if ($memoryModules.Count -eq 0) {
        Write-Host '  No memory module information was reported.' -ForegroundColor DarkYellow
    } else {
        $moduleNumber = 1
        foreach ($module in $memoryModules) {
            if ($memoryModules.Count -gt 1) { Write-Subsection ('Memory module ' + $moduleNumber) }
            $memoryType = Get-MemoryTypeName -Code ([int]$module.SMBIOSMemoryType)
            if ($memoryType -eq 'Unknown' -and $module.MemoryType) {
                $memoryType = Get-MemoryTypeName -Code ([int]$module.MemoryType)
            }
            $speed = if ($module.ConfiguredClockSpeed) { $module.ConfiguredClockSpeed } else { $module.Speed }
            $speedText = if ($speed) { '{0} MHz' -f $speed } else { 'Unknown' }
            Write-Field 'Capacity' (Format-Bytes ([UInt64]$module.Capacity))
            Write-Field 'Type' $memoryType
            Write-Field 'Speed' $speedText
            $moduleNumber++
        }
    }

    Write-Section 'STORAGE'
    Write-Subsection 'Physical drives'
    if ($physicalDisks.Count -eq 0) {
        Write-Host '  No physical drive information was reported.' -ForegroundColor DarkYellow
    } else {
        foreach ($disk in $physicalDisks) {
            $size = if ($disk.Size) { Format-Bytes ([UInt64]$disk.Size) } else { 'Unknown' }
            Write-Host ""
            Write-Host ('  Disk ' + $disk.Index) -ForegroundColor Green
            Write-Field 'Manufacturer' (Get-FirstUsableValue @($disk.Manufacturer))
            Write-Field 'Model' (Get-FirstUsableValue @($disk.Model))
            Write-Field 'Device-reported size' $size
        }
    }

    Write-Subsection 'Local drive space'
    if ($logicalDisks.Count -eq 0) {
        Write-Host '  No local drive information was reported.' -ForegroundColor DarkYellow
    } else {
        foreach ($disk in $logicalDisks) {
            $size = if ($null -ne $disk.Size) { [UInt64]$disk.Size } else { [UInt64]0 }
            $free = if ($null -ne $disk.FreeSpace) { [UInt64]$disk.FreeSpace } else { [UInt64]0 }
            $used = if ($size -ge $free) { $size - $free } else { [UInt64]0 }
            $volumeName = Get-FirstUsableValue @($disk.VolumeName)

            Write-Host ""
            Write-Host ('  ' + $disk.DeviceID + '  ' + $volumeName) -ForegroundColor Green
            Write-Field 'Total' (Format-Bytes $size)
            Write-Field 'Used' (Format-Bytes $used)
            Write-Field 'Free' (Format-Bytes $free)
        }
    }

    Write-Section 'MOTHERBOARD'
    if ($baseBoards.Count -eq 0) {
        Write-Field 'Make' 'Unknown'
        Write-Field 'Model' 'Unknown'
    } else {
        foreach ($board in $baseBoards) {
            Write-Field 'Make' (Get-FirstUsableValue @($board.Manufacturer))
            Write-Field 'Model' (Get-FirstUsableValue @($board.Product))
        }
    }

    Write-Section 'BIOS'
    Write-Field 'Version' (Get-FirstUsableValue @($bios.SMBIOSBIOSVersion, $bios.Version))
    if ($bios.ReleaseDate) {
        try {
            $releaseDate = ([Management.ManagementDateTimeConverter]::ToDateTime($bios.ReleaseDate).ToString('yyyy-MM-dd'))
            Write-Field 'Release date' $releaseDate
        } catch {
            Write-Field 'Release date' ([string]$bios.ReleaseDate)
        }
    }

    Write-Host ""
    Write-Host ('=' * 70) -ForegroundColor DarkCyan
} catch {
    Write-Host ''
    Write-Host ('Unable to gather all computer information: ' + $_.Exception.Message) -ForegroundColor Red
    exit 1
}
